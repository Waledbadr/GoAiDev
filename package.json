{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:base": "next dev -p 3000 -H 0.0.0.0",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:prod": "concurrently -k -n next,keep \"npm run dev:base\" \"npm run keep-alive\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate:workers": "node scripts/migrate-local-workers-to-firestore.mjs",
    "import:workers": "node scripts/import-workers-from-desktop.mjs",
    "convert:workers": "node scripts/convert-workers-data.mjs",
    "parse:text": "node scripts/parse-text-workers.mjs",
    "validate:workers": "node scripts/validate-workers-json.mjs",
    "keep-alive": "node scripts/keep-alive.mjs",
    "lookup:uid": "node --env-file=.env.local scripts/lookup-uid.mjs",
    "update:room-areas": "node --env-file=.env.local scripts/update-rooms-default-area.mjs",
    "export:d1": "node scripts/export-firestore-to-d1.mjs",
    "verify:billing": "tsx scripts/verify-billing-engine.mts",
    "migrate:contracts": "tsx scripts/migrate-contracts-to-v2.mts"
  },
  "dependencies": {
